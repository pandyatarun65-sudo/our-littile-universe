# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to Git — it's already in .gitignore.

SECRET_KEY=replace-with-a-long-random-string

USER1_NAME=Alex
USER1_EMAIL=alex@example.com
USER1_PASSWORD=changeme123

USER2_NAME=Sam
USER2_EMAIL=sam@example.com
USER2_PASSWORD=changeme456
